# Fourvenues Integrations API — production key for quartier-club.
# Never prefix with VITE_: that would ship the key to the browser.
# Local: copy to .env.local. Vercel: Project → Settings → Environment Variables.
FOURVENUES_API_KEY=

# Optional. Defaults to production.
