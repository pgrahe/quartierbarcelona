# Fourvenues — never prefix with VITE_: that would ship the keys to the browser.
# Local: copy to .env.local. Vercel: Project → Settings → Environment Variables.
#
# Integrations key (Quartier and any venue on that key)
FOURVENUES_API_KEY=
# Channel Manager key (all promoters on the channel: Velvet, Derby, …)
FOURVENUES_API_KEY_CHANNEL=

# Optional. Defaults to production Integrations API.
# FOURVENUES_API_BASE=https://api.fourvenues.com/integrations
