{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/countdown", "permanent": false },
    { "source": "/home", "destination": "/countdown", "permanent": false },
    { "source": "/sobre-nosotros", "destination": "/countdown", "permanent": false },
    { "source": "/vip-experience", "destination": "/countdown", "permanent": false },
    { "source": "/private-events", "destination": "/countdown", "permanent": false },

    { "source": "/en", "destination": "/en/countdown", "permanent": false },
    { "source": "/en/", "destination": "/en/countdown", "permanent": false },
    { "source": "/en/home", "destination": "/en/countdown", "permanent": false },
    { "source": "/en/about", "destination": "/en/countdown", "permanent": false },
    { "source": "/en/vip-experience", "destination": "/en/countdown", "permanent": false },
    { "source": "/en/private-events", "destination": "/en/countdown", "permanent": false },

    { "source": "/fr", "destination": "/fr/countdown", "permanent": false },
    { "source": "/fr/", "destination": "/fr/countdown", "permanent": false },
    { "source": "/fr/home", "destination": "/fr/countdown", "permanent": false },
    { "source": "/fr/a-propos", "destination": "/fr/countdown", "permanent": false },
    { "source": "/fr/vip-experience", "destination": "/fr/countdown", "permanent": false },
    { "source": "/fr/private-events", "destination": "/fr/countdown", "permanent": false },

    { "source": "/de", "destination": "/de/countdown", "permanent": false },
    { "source": "/de/", "destination": "/de/countdown", "permanent": false },
    { "source": "/de/home", "destination": "/de/countdown", "permanent": false },
    { "source": "/de/ueber-uns", "destination": "/de/countdown", "permanent": false },
    { "source": "/de/vip-experience", "destination": "/de/countdown", "permanent": false },
    { "source": "/de/private-events", "destination": "/de/countdown", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/logo_sinfondo_quartier_negro",
      "destination": "/logo_sinfondo_quartier_negro.png"
    }
  ],
  "headers": [
    {
      "source": "/logo_sinfondo_quartier_negro",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/logo_sinfondo_quartier_negro.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
